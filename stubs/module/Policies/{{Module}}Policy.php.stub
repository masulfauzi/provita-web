<?php

namespace App\Http\Modules\{{Module}}\Policies;

use App\Http\Modules\{{Module}}\Models\{{Module}};
use App\Models\User;

class {{Module}}Policy
{
    public function viewAny(User $user): bool
    {
        return $user->can('{{permission}}.lihat');
    }

    public function view(User $user, {{Module}} ${{variable}}): bool
    {
        return $user->can('{{permission}}.lihat');
    }

    public function create(User $user): bool
    {
        return $user->can('{{permission}}.tambah');
    }

    public function update(User $user, {{Module}} ${{variable}}): bool
    {
        return $user->can('{{permission}}.ubah');
    }

    public function delete(User $user, {{Module}} ${{variable}}): bool
    {
        return $user->can('{{permission}}.hapus');
    }
}
