<?php

namespace App\Http\Modules\{{Module}}\Services;

use App\Http\Modules\{{Module}}\Models\{{Module}};
use Illuminate\Contracts\Pagination\LengthAwarePaginator;

class {{Module}}Service
{
    public function paginate(string $search = '', int $perPage = 15): LengthAwarePaginator
    {
        return {{Module}}::query()
            ->when($search !== '', fn ($query) => $query->where('nama', 'like', "%{$search}%"))
            ->latest()
            ->paginate(min(max($perPage, 5), 100))
            ->withQueryString();
    }

    /**
     * @param  array<string, mixed>  $data
     */
    public function create(array $data): {{Module}}
    {
        return {{Module}}::create($data);
    }

    /**
     * @param  array<string, mixed>  $data
     */
    public function update({{Module}} ${{variable}}, array $data): {{Module}}
    {
        ${{variable}}->update($data);

        return ${{variable}};
    }

    public function delete({{Module}} ${{variable}}): void
    {
        ${{variable}}->delete();
    }
}
